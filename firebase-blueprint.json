        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "description": { "type": "string" },
        "badge": { "type": "string" },
        "category": { "type": "string" },
        "theme": { "type": "string" },
        "startAt": { "type": "string" },
        "endAt": { "type": "string" },
        "countdownEnabled": { "type": "boolean" },
        "status": { "type": "string" },
