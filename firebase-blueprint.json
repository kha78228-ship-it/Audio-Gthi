      },
      "required": ["title", "category", "status", "createdAt"]
    },
    "systemSettings": {
      "title": "System Setting Config",
      "description": "Platform global configuration variables and toggles",
      "type": "object",
      "properties": {
        "maintenanceMode": { "type": "boolean" },
        "maintenanceMessage": { "type": "string" },
        "allowRegistration": { "type": "boolean" },
        "allowAuthorSubmissions": { "type": "boolean" },
        "vipDiscountPercentage": { "type": "number" },
