        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userAccountId": { "type": "string" },
        "userPhoto": { "type": "string" },
        "isUserVip": { "type": "boolean" },
        "isAuthorVerified": { "type": "boolean" },
        "authorStageName": { "type": "string" },
        "text": { "type": "string", "maxLength": 140 },
