{
  "entities": {
    "users": {
      "title": "User Profile",
      "description": "User account information, Audio Points, VIP status and privileges",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "favoriteTrackIds": { "type": "array", "items": { "type": "string" } },
        "audioPoints": { "type": "number", "description": "Current balance of audio points" },
        "totalEarnedPoints": { "type": "number" },
        "totalListenedMinutes": { "type": "number" },
        "lastDailyCheckin": { "type": "string", "format": "date-time" },
        "vipTier": { "type": "string", "enum": ["free", "vip", "vip_master"] },
        "vipExpiresAt": { "type": "string", "format": "date-time" },
        "vipSettings": {
          "type": "object",
          "properties": {
            "hifiMode": { "type": "boolean" },
            "bassBoost": { "type": "boolean" },
            "spatial3D": { "type": "boolean" },
            "showVipBadge": { "type": "boolean" },
            "autoDownloadOffline": { "type": "boolean" }
          }
        },
        "shortcuts_config": {
          "type": "object",
          "description": "User personal customized keyboard shortcut mappings synchronized across devices"
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "createdAt"]
    },
    "vipOrders": {
      "title": "VIP Topup Order",
      "description": "Subscription and topup transactions for VIP packages with promo codes",
      "type": "object",
      "properties": {
        "packageId": { "type": "string" },
        "packageName": { "type": "string" },
        "durationDays": { "type": "number" },
        "originalAmount": { "type": "number" },
        "discountAmount": { "type": "number" },
        "finalAmount": { "type": "number" },
        "promoCodeApplied": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["packageId", "packageName", "durationDays", "finalAmount", "paymentMethod", "createdAt"]
    },
    "pointOrders": {
      "title": "Points/Coins Topup Order",
      "description": "Topup transactions for Audio Points / Coins packages",
      "type": "object",
      "properties": {
        "packageId": { "type": "string" },
        "packageName": { "type": "string" },
        "pointsAwarded": { "type": "number" },
        "originalAmount": { "type": "number" },
        "discountAmount": { "type": "number" },
        "finalAmount": { "type": "number" },
        "promoCodeApplied": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["packageId", "packageName", "pointsAwarded", "finalAmount", "paymentMethod", "createdAt"]
    },
    "pointTransactions": {
      "title": "Point Transaction",
      "description": "History of earned and spent audio points",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "amount", "type", "createdAt"]
    },
    "customTracks": {
      "title": "Community Audio Tracks",
      "description": "Audio tracks added by users to the shared library",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "artist": { "type": "string" },
        "url": { "type": "string" },
