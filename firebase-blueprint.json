        "updatedBy": { "type": "string" }
      },
      "required": ["maintenanceMode", "allowRegistration", "globalPointMultiplier"]
    },
    "thoughtBubbles": {
      "title": "Thought Bubble Note",
      "description": "User short status notes and thought bubbles displayed on friend avatars",
