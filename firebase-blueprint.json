        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "authorName", "content", "createdAt"]
    },
    "comments": {
      "title": "Post Comment",
      "description": "Comments on community posts",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorPhoto": { "type": "string" },
        "isAuthorVip": { "type": "boolean" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "authorName", "text", "createdAt"]
    },
    "referralCodes": {
      "title": "Admin Referral Code",
      "description": "6-character referral promo codes created by admin with max 100 redemptions each",
      "type": "object",
      "properties": {
        "code": { "type": "string", "maxLength": 6, "minLength": 6 },
        "maxUses": { "type": "number" },
        "usedCount": { "type": "number" },
        "usedByUids": { "type": "array", "items": { "type": "string" } },
        "rewardPoints": { "type": "number" },
        "rewardVipDays": { "type": "number" },
        "createdBy": { "type": "string" },
        "isActive": { "type": "boolean" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "maxUses", "usedCount", "rewardPoints", "createdBy", "createdAt"]
    },
    "authorVerifications": {
      "title": "Author Verification",
      "description": "Author eKYC verification submissions and status",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "fullName": { "type": "string" },
        "stageName": { "type": "string" },
        "email": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "idCardNumber": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "verified", "rejected"] },
        "submittedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "fullName", "stageName", "status", "submittedAt"]
    },
    "giftDonations": {
      "title": "Author Gift Donation",
      "description": "Virtual gifts sent to authors using Audio Points",
      "type": "object",
      "properties": {
        "senderUid": { "type": "string" },
        "senderName": { "type": "string" },
        "authorUid": { "type": "string" },
        "authorStageName": { "type": "string" },
        "giftId": { "type": "string" },
        "giftName": { "type": "string" },
        "giftIcon": { "type": "string" },
        "pointsCost": { "type": "number" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderUid", "authorUid", "giftId", "giftName", "pointsCost", "createdAt"]
    },
    "anonymousPasses": {
      "title": "Anonymous VIP Pass",
      "description": "Guest VIP passes with 3-digit (1 month) or 1-week duration without login",
      "type": "object",
      "properties": {
        "passCode": { "type": "string" },
        "type": { "type": "string", "enum": ["3_digit_month", "1_week"] },
        "durationDays": { "type": "number" },
        "usedCount": { "type": "number" },
        "isActive": { "type": "boolean" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["passCode", "durationDays", "type", "createdAt"]
    },
    "systemAuditLogs": {
      "title": "System Audit Log",
      "description": "Comprehensive transparency audit trail tracking all administrative and user activities without omissions",
      "type": "object",
      "properties": {
        "action": { "type": "string" },
        "actionTitle": { "type": "string" },
        "actorId": { "type": "string" },
        "actorName": { "type": "string" },
        "actorEmail": { "type": "string" },
        "actorRole": { "type": "string", "enum": ["admin", "user", "author"] },
        "targetType": { "type": "string" },
        "targetId": { "type": "string" },
        "targetName": { "type": "string" },
        "details": { "type": "string" },
        "severity": { "type": "string", "enum": ["info", "warning", "danger", "critical"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["action", "actionTitle", "actorId", "actorName", "details", "severity", "createdAt"]
    },
    "systemAnnouncements": {
      "title": "System Announcement",
      "description": "Global broadcast messages and maintenance notices published by administrators",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "event", "urgent", "maintenance"] },
        "isActive": { "type": "boolean" },
        "isPinned": { "type": "boolean" },
        "targetAudience": { "type": "string", "enum": ["all", "vip", "authors"] },
        "createdBy": { "type": "string" },
        "createdByName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "type", "isActive", "createdBy", "createdAt"]
    },
    "systemEvents": {
      "title": "Ecosystem & Upcoming Events",
      "description": "Admin customizable upcoming events, promotions, and tournaments",
