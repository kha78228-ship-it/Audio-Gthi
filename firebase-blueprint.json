        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "artist", "url", "genre", "addedBy"]
    },
    "communityPosts": {
      "title": "Community Post",
      "description": "Discussions, audio shares and recommendations by users",
